{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run FastAPI Backend",
      "type": "shell",
      "command": ".\\backend\\venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "backend"
      }
    },
    {
      "label": "Run React Frontend",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "frontend"
      }
    },
    {
      "label": "Run Full Application (Backend + Frontend)",
      "dependsOn": ["Run FastAPI Backend", "Run React Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Academic Analytics Suite",
      "type": "shell",
      "command": ".\\backend\\venv\\Scripts\\python.exe backend\\analytics\\employability_statistical_analysis.py",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
